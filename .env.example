# Copy to .env.local and fill in. Never commit real values.

# Neon (pooled host contains "-pooler")
DATABASE_URL=
DIRECT_URL=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Address printed in ID card QR links (must be final before printing cards)
APP_URL=https://gintongaraw.coderyan.dev
# Optional, for testing on a phone via your PC's LAN IP:
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.20:3000
# DEV_ALLOWED_ORIGINS=192.168.1.20

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gintong-araw


# First Super Admin (seed only)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
